			leia(cor_cabelos)
			
			escreva("Idade: ")
			leia(idade)

			se (idade > maior_idade)
			{
				maior_idade = idade
			}
			se (sexo == 'F' e idade >= 18 e idade <= 35 e cor_olhos == 'V' e cor_cabelos == 'L'){
			}
		}
		escreva("\n RESULTADO FINAL")
		escreva("\nA maior idade do grupo: ", maior_idade, " anos.")
		escreva("\nQuantidade de mulheres entre 18 e 35 anos com olhos verdes e cabelos louros: ")
	}
}
