programa {
  funcao inicio() {
    
      inteiro matricula
      real nota
    
    para(inteiro i=1; i <=75; i++){
      escreva("\nmatrícula:")
      leia(matricula)
     
      escreva("nota: ")
      leia(nota)
      se (nota >= 0.0 e nota <= 4.9){
      escreva ("\nConceito D")
      }senao se(nota >=5 e nota <= 6.9){
        escreva("\nConceito C")
      }senao se (nota >= 7 e nota <= 8.9){
        escreva("\nConceito B")
      }senao se (nota >= 9.0 e nota <= 10.0){
        escreva("\nConceito A")
        }
        }
      }
    }
